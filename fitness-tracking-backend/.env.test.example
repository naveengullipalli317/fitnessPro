# Loaded automatically when NODE_ENV=test (used by `npm run start:test` and
# Playwright's webServer). Copy to .env.test and adjust as needed.
# IMPORTANT: keep MONGODB_URI pointing at a DEDICATED test database — test runs
# may wipe data. Never reuse the dev/prod database here.
NODE_ENV=test
PORT=5001
MONGODB_URI=mongodb://localhost:27017/fitness_tracking_test
JWT_SECRET=test_jwt_secret_change_me
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=4
