# Shared defaults loaded after the env-specific file (see config/environment.js).
# Prefer keeping per-environment values in .env.development / .env.test instead;
# this file is only for keys that genuinely shouldn't vary by environment.

NODE_ENV=development
PORT=5000

# IMPORTANT: always include the database name in the path (the segment after
# the host). A bare trailing "/" makes Mongoose default to a database
# literally named "test" — which collides with the test environment naming
# and creates the "where did my data go?" class of bug.
#
# Recommended naming: fitness_tracking_dev (dev), fitness_tracking_test (test).
MONGODB_URI=mongodb://localhost:27017/fitness_tracking_dev

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Email delivery (optional) ----------------------------------------
# Used by /auth/forgot-password to send reset links. If MAIL_HOST is
# unset the app falls back to logging emails to stdout — perfect for
# local dev. Set these to wire any SMTP provider (Mailtrap, Gmail,
# SendGrid, Resend, etc.). Verify with: `npm run mail:test -- you@example.com`.
#
# Provider quick-reference:
#   Mailtrap sandbox: MAIL_HOST=sandbox.smtp.mailtrap.io PORT=2525 SECURE=false
#   Gmail (App Pwd):  MAIL_HOST=smtp.gmail.com PORT=587 SECURE=false  USER=you@gmail.com PASS=<16-char app password>
#   SendGrid SMTP:    MAIL_HOST=smtp.sendgrid.net PORT=587 SECURE=false USER=apikey PASS=<your API key>
#   Resend SMTP:      MAIL_HOST=smtp.resend.com PORT=465 SECURE=true   USER=resend  PASS=<your API key>
#
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_SECURE=false                # true only for implicit TLS (port 465)
# MAIL_FROM="NeverGiveUp <no-reply@yourdomain.com>"
# FRONTEND_URL=http://localhost:5173   # used to build reset links